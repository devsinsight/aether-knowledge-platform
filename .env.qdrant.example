# Copy to .env.qdrant and fill locally; never commit values. Used only by the qdrant service.
# Admin key: sync and pipeline (same value as QDRANT_API_KEY in .env).
QDRANT__SERVICE__API_KEY=
# Read-only key: the Knowledge MCP and Web UI browsing (same value as QDRANT_API_KEY in .env.knowledge-mcp).
QDRANT__SERVICE__READ_ONLY_API_KEY=
