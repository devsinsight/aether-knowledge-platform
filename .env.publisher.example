# Copy to .env.publisher and fill locally; never commit values. Used only by the publisher service,
# the only service with wiki write access.
CONFLUENCE_BASE_URL=https://devsinsight.atlassian.net/wiki
CONFLUENCE_SPACE=AETHER
# An account whose write access is limited to the Work Records tree, where Confluence allows it.
CONFLUENCE_WRITE_EMAIL=
CONFLUENCE_WRITE_API_TOKEN=
# The "Work Records" page created by a person in the space (outside sections 0-8).
WORK_RECORDS_PARENT_PAGE_ID=
# Read-only Azure DevOps PAT (Work Items: Read), to confirm that the anchored story exists.
ADO_ORG_URL=https://dev.azure.com/devsinsight
ADO_PROJECT=Aether
ADO_READ_PAT=
