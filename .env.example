# Variable names only. Copy to .env and fill locally; never commit values.
# Used by the sync and pipeline services. Use a read-only Atlassian account and an API token
# scoped to read Confluence.
CONFLUENCE_BASE_URL=https://devsinsight.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
QDRANT_URL=http://localhost:6333
# Qdrant admin key (same value as QDRANT__SERVICE__API_KEY in .env.qdrant); empty when Qdrant has no keys.
QDRANT_API_KEY=
